{
  "name": "phi-lite-scientific-metrics",
  "version": "1.0",
  "purpose": "Local, append-only dumps for audit, emergence screening, and enhancement targeting.",
  "files": {
    "metrics.jsonl": "one record per agent cycle",
    "events.jsonl": "sparse records only when a detector fires",
    "audit_snapshot.json": "periodic rollup aligned to the 144-point audit",
    "novelty_index.json": "running baselines for distance and rarity"
  },
  "cycle_record": {
    "t": "unix float",
    "cycle": "int",
    "dt_ms": "float",
    "action": "string",
    "pi": "object action->prob",
    "H_pi": "policy entropy nats",
    "argmax_margin": "p_max - p_second",
    "horizon": "int",
    "fp_err": "float",
    "fp_iter": "int",
    "attn": "float",
    "c": "recursive confidence if present else null",
    "ledger_n": "int",
    "b_l2": "float",
    "h_l2": "float",
    "s_l2": "float",
    "novelty_b": "distance of b to ledger centroid",
    "prompt_pending": "bool",
    "io_error": "string|null",
    "weights_sha1": "hex of weights.json mtime+size proxy"
  },
  "event_types": [
    "MODE_COLLAPSE",
    "ENTROPY_DROP",
    "ENTROPY_SPIKE",
    "HORIZON_STICK",
    "HORIZON_SHIFT",
    "FP_TRANSIENT",
    "FP_STUCK",
    "REPAIR_NOOP",
    "MONODROMY_HIT",
    "NOVEL_BOUNDARY",
    "REGIME_SHIFT",
    "PROMPT_CONSUMED",
    "CYCLE_RESET",
    "DT_GAP",
    "IO_FAULT",
    "WEIGHT_MUTATION",
    "STATE_DISCONTINUITY",
    "ACTION_INNOVATION",
    "SAFETY_MASK",
    "EMERGENCE_CANDIDATE"
  ]
}
