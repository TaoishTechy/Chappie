{
  "codename": "Φ-Lite",
  "version": "0.7.0",
  "bind": "127.0.0.1",
  "port": 8080,
  "cycle_ms": 350,
  "target_hz": 3,
  "video": {
    "device": "/dev/video0",
    "width": 160,
    "height": 120,
    "fps": 10,
    "motion_threshold": 0.02,
    "mock_if_missing": true
  },
  "audio": {
    "sample_rate": 16000,
    "chunk_sec": 1.0,
    "mel_bins": 40,
    "mock_if_missing": true,
    "tts_backend": "print"
  },
  "ledger": { "capacity": 32, "dim": 64 },
  "dims": {
    "z_v": 32, "z_a": 32, "b": 64, "coarse": 32,
    "h": 64, "s": 32, "E": 16, "actions": 8
  },
  "self_model": { "iters": 5, "eps": 0.01, "c_iters": 3 },
  "entropy_beta": 0.55,
  "epsilon_start": 0.10,
  "epsilon_end": 0.02,
  "epsilon_anneal_cycles": 2000,
  "h_pi_lo": 1.1,
  "h_pi_hi": 1.6,
  "repeat_penalty": 0.70,
  "pair_penalty": 1.20,
  "pair_share_ban": 0.50,
  "intent_gap_max": 0.35,
  "band": { "lam_min": 0.02, "lam_max": 0.45, "window": 32 },
  "repair": { "fp_min": 0.05, "pred_slope_min": 0.0, "e_drop": 0.02 },
  "memory": { "episodes": 128, "knn": 3 },
  "learn": {
    "enabled": true,
    "lr_world": 0.02,
    "lr_policy": 0.004,
    "persist_every": 16,
    "freeze_if_no_improve": 64
  },
  "horizons": [1, 3, 5, 10],
  "rotate_lines": 2000,
  "mcfe": { "c_skip": 0.72, "novelty_skip": 1.0 },
  "safety": {
    "min_action_interval_ms": 200,
    "watchdog_ms": 2000,
    "allow_gpio": false,
    "allow_network_exfil": false,
    "allow_self_modify": false,
    "max_prompt_bytes": 4096
  },
  "paths": {
    "architecture": "architecture.json",
    "safety": "safety.json",
    "dashboard": "dashboard.json",
    "weights": "weights.json",
    "state": "state.json",
    "ledger": "ledger.jsonl",
    "log": "logs.jsonl",
    "metrics": "metrics/metrics.jsonl",
    "events": "metrics/events.jsonl"
  }
}
